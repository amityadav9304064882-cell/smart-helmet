                        </div>
                      </div>
                    </div>
                  );
                })()
              )}

              {/* ROUTE 10: EMERGENCY RESPONSE DASHBOARD (#emergency-response) */}
              {currentRoute === '#emergency-response' && (
                <div className="space-y-6 animate-page-slide">
                  <div className="bg-gradient-to-r from-red-950/40 via-mine-900 to-mine-900 border border-red-500/40 rounded-3xl p-5 flex justify-between items-center">
                    <div>
                      <div className="text-xs font-bold text-red-400 uppercase">Emergency Operations</div>
                      <h2 className="text-xl font-extrabold text-white">Subterranean Rescue Command</h2>
                    </div>
                  </div>

                  <div className="space-y-4">
                    {workers.filter(w => calcSafetyScore(w).score < 60).map(w => {
                      const s = calcSafetyScore(w);
                      return (
                        <div key={w.workerId} className="p-6 bg-mine-900 border border-red-500/40 rounded-3xl space-y-4">
                          <div className="flex justify-between items-start">
                            <div className="flex items-center space-x-3">
                              <HelmetIcon size={30} color={s.color} />
                              <div>
                                <h3 className="text-base font-bold text-white">{w.name}</h3>
                                <div className="text-xs text-mine-400">{w.workerId} • Block {w.block} ({w.zone})</div>
                              </div>
                            </div>
                            <span className="text-sm font-bold text-red-400 bg-red-500/20 px-3 py-1 rounded-xl">Score: {s.score}%</span>
                          </div>

                          <div className="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
                            <div className="p-3 bg-mine-950 rounded-xl border border-mine-850">
                              <span className="text-mine-400">Rescue Team Status:</span>
                              <div className="font-bold text-blue-400">{w.telemetry.rescueStatus || 'Standby Ready'}</div>
                            </div>
                            <div className="p-3 bg-mine-950 rounded-xl border border-mine-850">
                              <span className="text-mine-400">Ambulance Status:</span>
                              <div className="font-bold text-hazard">Dispatched to Surface Pithead</div>
                            </div>
                            <div className="p-3 bg-mine-950 rounded-xl border border-mine-850">
                              <span className="text-mine-400">NDRF Status:</span>
                              <div className="font-bold text-emerald-400">District Base Notified</div>
                            </div>
                          </div>

                          {/* Action Buttons with confirmation popup for Ambulance & NDRF */}
                          <div className="flex flex-wrap items-center justify-end gap-2 pt-2 border-t border-mine-800 text-xs font-bold">
                            <button
                              onClick={() => {
                                setConfirmationModal({
                                  isOpen: true,
                                  title: 'Confirm Ambulance Dispatch',
                                  message: `Send official ALS Ambulance to Pithead for ${w.name} (${w.workerId}) in Block ${w.block}?`,
                                  onConfirm: () => { setConfirmationModal({ isOpen: false }); alert('Ambulance Dispatched!'); }
                                });
                              }}
                              className="px-3.5 py-2 rounded-xl bg-mine-950 border border-mine-700 text-hazard hover:text-white"
                            >
                              Notify Ambulance
                            </button>

                            <button
                              onClick={() => {
                                setConfirmationModal({
                                  isOpen: true,
                                  title: 'Confirm NDRF Mobilization',
                                  message: `Requisition National Disaster Response Force (NDRF) for Block ${w.block} evacuation?`,
                                  onConfirm: () => { setConfirmationModal({ isOpen: false }); alert('NDRF Mobilized!'); }
                                });
                              }}
                              className="px-3.5 py-2 rounded-xl bg-mine-950 border border-mine-700 text-emerald-400 hover:text-white"
                            >
                              Notify NDRF
                            </button>

                            <button onClick={() => alert('Supervisor called!')} className="px-3.5 py-2 rounded-xl bg-mine-950 border border-mine-700 text-white">
                              Call Mine Supervisor
                            </button>

                            <button onClick={() => alert(`Evacuation initiated for Worker ${w.workerId}!`)} className="px-3.5 py-2 rounded-xl bg-red-600 text-white">
                              Start Evacuation
                            </button>

                            <button
                              onClick={() => {
                                setWorkers(workers.map(item => item.workerId === w.workerId ? { ...item, telemetry: { ...item.telemetry, sosPressed: false, fallDetected: false, mq2_methane_ppm: 30, rescueStatus: 'NONE' } } : item));
                              }}
                              className="px-4 py-2 rounded-xl bg-emerald-600 text-white"
                            >
                              Mark Worker Safe
                            </button>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </div>
              )}

              {/* ROUTE 11: REPORTS DASHBOARD (#reports) */}
              {currentRoute === '#reports' && (
                <div className="space-y-6 animate-page-slide">
                  <div className="bg-mine-900 border border-mine-800 rounded-3xl p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                      <div className="text-xs font-bold text-hazard uppercase">Compliance & Audits</div>
                      <h2 className="text-xl font-extrabold text-white">Mine Safety Reports Dashboard</h2>
                    </div>

                    <div className="flex space-x-2">
                      <button
                        onClick={() => {
                          const csv = "Worker ID,Helmet ID,Name,Block,Zone,Score\n" + workers.map(w => `${w.workerId},${w.helmetId},"${w.name}",${w.block},"${w.zone}",${calcSafetyScore(w).score}`).join("\n");
                          const blob = new Blob([csv], { type: 'text/csv' });
                          const url = URL.createObjectURL(blob);
                          const a = document.createElement('a');
                          a.href = url;
                          a.download = `mineshield_report_${Date.now()}.csv`;
                          a.click();
                        }}
                        className="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs shadow-md"
                      >
                        Export CSV Report
                      </button>
                      <button
                        onClick={() => window.print()}
                        className="px-4 py-2 rounded-xl bg-mine-950 border border-mine-800 text-hazard font-bold text-xs hover:bg-mine-900"
                      >
                        Print PDF
                      </button>
                    </div>
                  </div>

                  <div className="bg-mine-900 border border-mine-800 rounded-3xl p-6 overflow-x-auto space-y-4">
                    <div className="text-xs font-bold text-white uppercase">Worker Check-In / Check-Out Manifest (30 Miners)</div>
                    <table className="w-full text-left text-xs divide-y divide-mine-800">
                      <thead>
                        <tr className="text-mine-400 uppercase text-[10px]">
                          <th className="py-2">Worker</th>
                          <th className="py-2">Block & Zone</th>
                          <th className="py-2">Phone</th>
                          <th className="py-2">Entry Time</th>
                          <th className="py-2">Safety Score</th>
                          <th className="py-2">Battery</th>
                        </tr>
                      </thead>
                      <tbody className="divide-y divide-mine-850">
                        {workers.map(w => {
                          const s = calcSafetyScore(w);
                          return (
                            <tr key={w.workerId} className="hover:bg-mine-950/50">
                              <td className="py-2.5 font-bold text-white">{w.name} ({w.workerId})</td>
                              <td className="py-2.5">Block {w.block} ({w.zone})</td>
                              <td className="py-2.5 text-mine-400">{w.homePhone}</td>
                              <td className="py-2.5">{w.entryTime}</td>
                              <td className="py-2.5 font-bold" style={{ color: s.color }}>{s.score}%</td>
                              <td className="py-2.5 text-emerald-400">{w.telemetry.battery}%</td>
                            </tr>
                          );
                        })}
                      </tbody>
                    </table>
                  </div>
                </div>
              )}

              {/* ROUTE 12: SETTINGS AND DISCLAIMER DASHBOARD (#settings) */}
              {currentRoute === '#settings' && (
                <div className="space-y-6 animate-page-slide">
                  <div className="bg-mine-900 border border-mine-800 rounded-3xl p-5">
                    <h2 className="text-xl font-extrabold text-white">Settings & Regulatory Disclaimer</h2>
                    <p className="text-xs text-mine-400 mt-0.5">Platform compliance specifications and hardware IoT firmware</p>
                  </div>

                  {/* Statutory Mandatory Disclaimer */}
                  <div className="bg-amber-950/40 border-2 border-amber-500/70 rounded-3xl p-6 shadow-xl space-y-3">
                    <div className="text-xs font-black text-amber-400 uppercase">Statutory Platform Notice & Disclaimer:</div>
                    <blockquote className="text-sm sm:text-base font-bold text-white leading-relaxed border-l-4 border-hazard pl-4 py-1 bg-mine-950/60 rounded-r-xl">
                      “MineShield is a prototype early-warning and decision-support platform. It does not replace certified mine safety equipment, government regulations, trained mine-rescue teams, gas-monitoring systems, or emergency protocols.”
                    </blockquote>
                    <p className="text-xs text-mine-400">
                      Designed for assistive decision support in mining operations adhering to DGMS compliance frameworks.
                    </p>
                  </div>

                  {/* Future ESP32 Hardware Integration Hub */}
                  <div className="bg-mine-900 border border-mine-800 rounded-3xl p-6 space-y-4">
                    <h3 className="text-xs font-bold text-white uppercase">Future ESP32 Data Integration Architecture</h3>
                    <div className="grid grid-cols-1 sm:grid-cols-4 gap-3 text-xs">
                      <div className="p-3 bg-mine-950 rounded-xl border border-mine-850">
                        <div className="text-hazard font-bold">1. MQTT Broker</div>
                        <div className="text-[11px] text-mine-400 mt-1">Topic: mineshield/telemetry/+</div>
                      </div>
                      <div className="p-3 bg-mine-950 rounded-xl border border-mine-850">
                        <div className="text-orange-400 font-bold">2. Firebase Realtime</div>
                        <div className="text-[11px] text-mine-400 mt-1">Path: /helmets/&#123;id&#125;</div>
                      </div>
                      <div className="p-3 bg-mine-950 rounded-xl border border-mine-850">
                        <div className="text-cyan-400 font-bold">3. WebSockets</div>
                        <div className="text-[11px] text-mine-400 mt-1">Endpoint: wss://gateway/ws</div>
                      </div>
                      <div className="p-3 bg-mine-950 rounded-xl border border-mine-850">
                        <div className="text-blue-400 font-bold">4. REST API</div>
                        <div className="text-[11px] text-mine-400 mt-1">POST /api/v1/telemetry</div>
                      </div>
                    </div>

                    <div>
                      <div className="text-xs text-mine-400 uppercase font-bold mb-2">Arduino C++ ESP32 Firmware Snippet:</div>
                      <pre className="p-4 bg-mine-950 border border-mine-850 rounded-2xl text-[11px] text-emerald-400 overflow-x-auto max-h-[220px] font-mono">
{`#include <WiFi.h>
#include <PubSubClient.h>

const char* helmetId = "HLM-B-002";
void setup() {
  Serial.begin(115200);
  pinMode(PIN_MQ2, INPUT);
  pinMode(PIN_SOS, INPUT_PULLUP);
}
void loop() {
  int ch4 = analogRead(PIN_MQ2);
  bool sos = digitalRead(PIN_SOS) == LOW;
  // Publish JSON packet over LoRa / MQTT
  delay(1000);
}`}
                      </pre>
                    </div>
                  </div>
                </div>
              )}

            </main>
          </div>

          {/* CONFIRMATION POPUP MODAL (FOR AMBULANCE / NDRF NOTIFICATIONS) */}
          {confirmationModal.isOpen && (
            <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm animate-page-slide">
              <div className="bg-mine-900 border border-red-500/60 rounded-3xl max-w-md w-full p-6 space-y-4 text-white shadow-2xl">
                <div className="flex items-center space-x-2 text-red-400 font-bold text-sm">
                  <span>🚨</span>
                  <span>{confirmationModal.title}</span>
                </div>
                <p className="text-xs text-mine-300 leading-relaxed">{confirmationModal.message}</p>
                <div className="flex justify-end space-x-2 pt-2 border-t border-mine-800 text-xs font-bold">
                  <button onClick={() => setConfirmationModal({ isOpen: false })} className="px-3.5 py-2 rounded-xl bg-mine-950 border border-mine-800 text-mine-400">Cancel</button>
                  <button onClick={confirmationModal.onConfirm} className="px-4 py-2 rounded-xl bg-red-600 text-white">Confirm Official Dispatch</button>
                </div>
              </div>
            </div>
          )}
        </div>
      );
    }

    ReactDOM.render(<MineShieldApp />, document.getElementById('root'));
  </script>
</body>
</html>
