    // --- 3. SAFETY SCORING HELPER ---
    function calcSafetyScore(w) {
      const t = w.telemetry || {};
      if (t.sosPressed) {
        return { score: 8, tier: 'CRITICAL', color: '#ef4444', text: 'NOT SAFE (SOS PRESSED)' };
      }
      let score = 100;
      if (!t.online) score -= 45;
      if (t.fallDetected) score -= 55;
      if (t.motionState === 'IMMOBILE') score -= 60;
      if (t.waterDetected) score -= 50;
      if (t.mq2_methane_ppm > 350) score -= 65;
      else if (t.mq2_methane_ppm > 150) score -= 35;
      else if (t.mq2_methane_ppm > 70) score -= 15;
      if (t.mq7_co_ppm > 30) score -= 25;
      if (t.oxygen_pct < 19.5) score -= 20;

      score = Math.max(5, Math.min(100, score));

      if (score >= 80) return { score, tier: 'SAFE', color: '#10b981', text: 'SAFE' };
      if (score >= 60) return { score, tier: 'CAUTION', color: '#eab308', text: 'CAUTION' };
      if (score >= 40) return { score, tier: 'HIGH RISK', color: '#f97316', text: 'HIGH RISK' };
      return { score, tier: 'CRITICAL', color: '#ef4444', text: 'NOT SAFE / CRITICAL' };
    }

    function getHelmetColor(w) {
      const t = w.telemetry || {};
      if (!t.online) return { fill: '#6b7280', label: 'Offline' };
      if (t.rescueStatus && t.rescueStatus !== 'NONE') return { fill: '#3b82f6', label: 'Rescue Team Assigned' };
      const s = calcSafetyScore(w);
      if (s.score >= 80) return { fill: '#10b981', label: 'Safe' };
      if (s.score >= 60) return { fill: '#eab308', label: 'Caution' };
      if (s.score >= 40) return { fill: '#f97316', label: 'High Risk' };
      return { fill: '#ef4444', label: 'Not Safe / Critical' };
    }

    // --- 4. ANIMATED SAFETY GAUGE WITH COUNT-UP & REDUCED MOTION ---
    function AnimatedGauge({ score, size = 115, strokeWidth = 11 }) {
      const s = calcSafetyScore({ telemetry: {}, scoreOverride: score });
      const radius = (size - strokeWidth) / 2;
      const circumference = radius * 2 * Math.PI;

      const [displayedScore, setDisplayedScore] = useState(0);
      const [animatedOffset, setAnimatedOffset] = useState(circumference);

      const prefersReducedMotion = useRef(
        typeof window !== 'undefined' &&
        window.matchMedia &&
        window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ).current;

      useEffect(() => {
        if (prefersReducedMotion) {
          setDisplayedScore(score);
          setAnimatedOffset(circumference - (score / 100) * circumference);
          return;
        }

        let startTimestamp = null;
        const duration = 1000;
        const targetOffset = circumference - (score / 100) * circumference;

        const timer = setTimeout(() => setAnimatedOffset(targetOffset), 100);

        const step = (timestamp) => {
          if (!startTimestamp) startTimestamp = timestamp;
          const progress = Math.min((timestamp - startTimestamp) / duration, 1);
          const easeProgress = 1 - Math.pow(1 - progress, 3);
          setDisplayedScore(Math.round(easeProgress * score));
          if (progress < 1) requestAnimationFrame(step);
        };

        const frame = requestAnimationFrame(step);
        return () => {
          clearTimeout(timer);
          cancelAnimationFrame(frame);
        };
      }, [score, circumference, prefersReducedMotion]);

      let tierColor = '#10b981';
      if (score < 40) tierColor = '#ef4444';
      else if (score < 60) tierColor = '#f97316';
      else if (score < 80) tierColor = '#eab308';

      return (
        <div className="relative flex flex-col items-center justify-center">
          <div className="relative" style={{ width: size, height: size }}>
            <svg className="w-full h-full transform -rotate-90" viewBox={`0 0 ${size} ${size}`}>
              <circle cx={size / 2} cy={size / 2} r={radius} stroke="#1c232d" strokeWidth={strokeWidth} fill="transparent" />
              <circle
                cx={size / 2}
                cy={size / 2}
                r={radius}
                stroke={tierColor}
                strokeWidth={strokeWidth}
                strokeDasharray={circumference}
                strokeDashoffset={animatedOffset}
                strokeLinecap="round"
                fill="transparent"
                style={{
                  transition: prefersReducedMotion ? 'none' : 'stroke-dashoffset 1.1s cubic-bezier(0.16, 1, 0.3, 1)',
                  filter: `drop-shadow(0 0 6px ${tierColor}80)`
                }}
              />
            </svg>
            <div className="absolute inset-0 flex flex-col items-center justify-center text-center select-none">
              <span className="font-mono font-extrabold text-xl tracking-tight" style={{ color: tierColor }}>
                {displayedScore}%
              </span>
              <span
                className="text-[9px] font-bold uppercase tracking-widest px-1.5 py-0.5 rounded mt-0.5"
                style={{ backgroundColor: `${tierColor}20`, color: tierColor, border: `1px solid ${tierColor}40` }}
              >
                {score >= 80 ? 'SAFE' : (score >= 60 ? 'CAUTION' : 'CRITICAL')}
              </span>
            </div>
          </div>
        </div>
      );
    }

