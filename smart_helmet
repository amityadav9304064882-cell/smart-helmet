                      </div>

                      <div className={`p-6 md:p-8 rounded-3xl border space-y-5 ${!isAck && alertItem.severity === 'CRITICAL' ? 'bg-red-500/15 border-red-500 animate-flash-danger' : 'bg-mine-900 border-mine-800'}`}>
                        <div className="flex justify-between items-center pb-3 border-b border-mine-800">
                          <span className="px-3 py-1 rounded bg-red-600 text-white text-xs font-bold uppercase">{alertItem.severity} EMERGENCY</span>
                          <span className="text-xs text-mine-400">{alertItem.time}</span>
                        </div>

                        <div>
                          <div className="text-xs text-mine-400 uppercase mb-1">Problem Description:</div>
                          <div className="text-base font-bold text-white bg-mine-950 p-4 rounded-2xl border border-mine-850">
                            {alertItem.message}
                          </div>
                        </div>

                        <div className="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
                          <div className="p-3 bg-mine-950 rounded-xl border border-mine-850">
                            <div className="text-mine-400">Block & Zone</div>
                            <div className="font-bold text-white">Block {alertItem.block} ({alertItem.zone})</div>
                          </div>
                          <div className="p-3 bg-mine-950 rounded-xl border border-mine-850">
                            <div className="text-mine-400">Worker ID</div>
                            <div className="font-bold text-hazard">{alertItem.workerId}</div>
                          </div>
                          <div className="p-3 bg-mine-950 rounded-xl border border-mine-850">
                            <div className="text-mine-400">Sensor Reading</div>
