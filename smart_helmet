                            className="px-3 py-1.5 rounded-xl bg-red-600 hover:bg-red-500 text-white text-xs font-bold"
                          >
                            {t.sosPressed ? 'Reset SOS' : 'Send Emergency Alert (SOS)'}
                          </button>
                          <button
                            onClick={() => navigate('#emergency-response')}
