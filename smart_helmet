                              <span className="text-xs bg-cyan-500/20 text-cyan-400 px-2 py-0.5 rounded font-bold">Helmet: {worker.helmetId}</span>
                            </div>
                            <div className="text-xs text-mine-400">
                              {worker.designation} • Block {worker.block} ({worker.zone}) • Blood: <span className="text-red-400 font-bold">{worker.bloodGroup}</span>
                            </div>
                            <div className="text-xs text-mine-400">
                              Phone: <strong className="text-white">{worker.homePhone}</strong> • Emergency: {worker.emergencyContact}
                            </div>
                          </div>
                        </div>

                        {/* Animated Gauge */}
                        <div className="flex items-center space-x-5 border-t lg:border-t-0 lg:border-l border-mine-800 pt-3 lg:pt-0 lg:pl-5">
                          <AnimatedGauge score={s.score} size={115} strokeWidth={11} />
                          <div className="text-xs text-mine-400 space-y-1">
                            <div>Battery: <strong className="text-emerald-400">{t.battery}%</strong></div>
                            <div>Mesh Signal: <strong className="text-emerald-400">{t.signal_rssi} dBm</strong></div>
                            <div>Status: <strong style={{ color: colorObj.fill }}>{colorObj.label}</strong></div>
                          </div>
                        </div>
                      </div>

                      {/* Staggered Sensors Grid (Delays 0.14s to 0.30s) */}
                      <div className="grid grid-cols-2 sm:grid-cols-5 gap-3.5 text-xs">
                        <div className="profile-section-anim p-4 rounded-2xl bg-mine-900 border border-mine-800" style={{ animationDelay: '0.14s' }}>
                          <div className="text-mine-400 mb-1">METHANE (CH4)</div>
                          <div className={`text-xl font-black ${t.mq2_methane_ppm > 250 ? 'text-red-400' : 'text-white'}`}>{t.mq2_methane_ppm} ppm</div>
                        </div>
                        <div className="profile-section-anim p-4 rounded-2xl bg-mine-900 border border-mine-800" style={{ animationDelay: '0.18s' }}>
                          <div className="text-mine-400 mb-1">CARBON MONOXIDE</div>
                          <div className={`text-xl font-black ${t.mq7_co_ppm > 30 ? 'text-red-400' : 'text-white'}`}>{t.mq7_co_ppm} ppm</div>
                        </div>
                        <div className="profile-section-anim p-4 rounded-2xl bg-mine-900 border border-mine-800" style={{ animationDelay: '0.22s' }}>
                          <div className="text-mine-400 mb-1">OXYGEN (O2)</div>
                          <div className={`text-xl font-black ${t.oxygen_pct < 19.5 ? 'text-red-400' : 'text-white'}`}>{t.oxygen_pct}%</div>
                        </div>
                        <div className="profile-section-anim p-4 rounded-2xl bg-mine-900 border border-mine-800" style={{ animationDelay: '0.26s' }}>
                          <div className="text-mine-400 mb-1">TEMP / HUMIDITY</div>
                          <div className="text-xl font-black text-white">{t.temp_c}°C / {t.humidity_pct}%</div>
                        </div>
                        <div className="profile-section-anim p-4 rounded-2xl bg-mine-900 border border-mine-800" style={{ animationDelay: '0.30s' }}>
                          <div className="text-mine-400 mb-1">LAST MOTION</div>
                          <div className={`text-sm font-black ${t.motionState === 'IMMOBILE' ? 'text-red-400' : 'text-emerald-400'}`}>
                            {t.motionState === 'IMMOBILE' ? 'NO MOTION > 3m' : 'ACTIVE'}
                          </div>
                        </div>
                      </div>

                      {/* Staggered Status Indicators (Delays 0.34s to 0.42s) */}
                      <div className="grid grid-cols-1 md:grid-cols-3 gap-3.5 text-xs">
                        <div className="profile-section-anim p-4 rounded-2xl bg-mine-900 border border-mine-800 flex justify-between items-center" style={{ animationDelay: '0.34s' }}>
                          <div>
                            <div className="text-[10px] text-mine-400 uppercase font-bold">Panic SOS Trigger</div>
                            <div className={`text-sm font-bold ${t.sosPressed ? 'text-red-400' : 'text-white'}`}>
                              {t.sosPressed ? 'MANUAL SOS ACTIVE' : 'Standby Normal'}
                            </div>
                          </div>
                          <span className="text-xl">{t.sosPressed ? '🚨' : '🛡️'}</span>
                        </div>

                        <div className="profile-section-anim p-4 rounded-2xl bg-mine-900 border border-mine-800 flex justify-between items-center" style={{ animationDelay: '0.38s' }}>
                          <div>
                            <div className="text-[10px] text-mine-400 uppercase font-bold">IMU Fall Status</div>
                            <div className={`text-sm font-bold ${t.fallDetected ? 'text-red-400' : 'text-white'}`}>
                              {t.fallDetected ? 'FALL DETECTED' : 'Nominal Motion'}
                            </div>
                          </div>
                          <span className="text-xl">{t.fallDetected ? '⚠️' : '✅'}</span>
                        </div>

                        <div className="profile-section-anim p-4 rounded-2xl bg-mine-900 border border-mine-800 flex justify-between items-center" style={{ animationDelay: '0.42s' }}>
                          <div>
                            <div className="text-[10px] text-mine-400 uppercase font-bold">Water Probe</div>
                            <div className={`text-sm font-bold ${t.waterDetected ? 'text-cyan-400' : 'text-white'}`}>
                              {t.waterDetected ? 'WATER INGRESS DETECTED' : 'Dry Working Face'}
                            </div>
                          </div>
                          <span className="text-xl">{t.waterDetected ? '💧' : '⛏️'}</span>
                        </div>
                      </div>
                    </div>
                  );
                })()
              )}

              {/* ROUTE 8: ALERTS DASHBOARD (#alerts) */}
              {currentRoute === '#alerts' && (
                <div className="space-y-6 animate-page-slide">
                  <div className="bg-mine-900 border border-mine-800 rounded-3xl p-5 flex justify-between items-center">
                    <div>
                      <div className="text-xs font-bold text-red-400 uppercase">Emergency Telemetry Hub</div>
                      <h2 className="text-xl font-extrabold text-white">Active Notifications & Alerts</h2>
                    </div>
                  </div>

                  <div className="space-y-3">
                    {activeAlerts.map(alt => {
                      const isAck = acknowledgedAlerts.has(alt.id);
                      return (
                        <div
                          key={alt.id}
                          onClick={() => navigate(`#alert-details/${alt.id}`)}
                          className={`p-5 rounded-3xl border cursor-pointer flex justify-between items-center ${
                            alt.severity === 'CRITICAL' && !isAck ? 'bg-red-500/15 border-red-500 animate-flash-danger' : 'bg-mine-900 border-mine-800'
                          }`}
                        >
                          <div className="space-y-1.5">
                            <div className="flex items-center space-x-2">
                              <span className={`px-2 py-0.5 rounded text-[10px] font-black ${alt.severity === 'CRITICAL' ? 'bg-red-600 text-white' : 'bg-yellow-500/20 text-yellow-400'}`}>
                                {alt.severity}
                              </span>
                              <span className="text-xs font-bold text-white">Alert {alt.id}</span>
                              <span className="text-xs text-mine-400">Block {alt.block} • {alt.zone} • {alt.workerId}</span>
                              {isAck && <span className="text-[10px] text-emerald-400 font-bold bg-emerald-500/20 px-2 rounded">ACKNOWLEDGED</span>}
                            </div>
                            <div className="text-sm font-bold text-white">{alt.message}</div>
                            <div className="text-xs text-mine-400">Sensor Value: <strong className="text-hazard">{alt.sensorValue}</strong> | Safety Score: <strong className="text-red-400">{alt.safetyScore}%</strong></div>
                          </div>
                          <button className="px-4 py-2 rounded-xl bg-mine-800 hover:bg-hazard hover:text-mine-950 text-white text-xs font-bold transition">
                            Inspect Alert →
                          </button>
                        </div>
                      );
                    })}
                  </div>
                </div>
              )}

              {/* ROUTE 9: ALERT DETAILS DASHBOARD (#alert-details) */}
              {(currentRoute === '#alert-details' || currentRoute.startsWith('#alert-details')) && (
                (() => {
                  const targetAlertId = routeParam || activeAlerts[0]?.id;
                  const alertItem = activeAlerts.find(a => a.id === targetAlertId) || activeAlerts[0];
                  if (!alertItem) return <div className="p-6 text-center text-mine-400">No alert active.</div>;

                  const isAck = acknowledgedAlerts.has(alertItem.id);

                  return (
                    <div className="max-w-4xl mx-auto space-y-6 animate-page-slide">
                      <div className="bg-mine-900 border border-mine-800 rounded-3xl p-5 flex justify-between items-center">
                        <button onClick={() => navigate('#alerts')} className="text-xs text-mine-400 hover:text-white">← Return to Alerts</button>
