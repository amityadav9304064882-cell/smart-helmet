                          </button>
                        </div>
                      );
                    })}
                  </div>
                </div>
              )}

              {/* ROUTE 6: NEW WORKER ENTRY DASHBOARD (#new-worker-entry) */}
              {currentRoute === '#new-worker-entry' && (
                (() => {
                  const [newName, setNewName] = useState('');
                  const [newWorkerId, setNewWorkerId] = useState('');
                  const [newHelmetId, setNewHelmetId] = useState('');
                  const [newBlock, setNewBlock] = useState('A');
                  const [newZone, setNewZone] = useState('Zone A-01');
                  const [newShift, setNewShift] = useState('Morning (06:00 - 14:00)');
                  const [newEntryTime, setNewEntryTime] = useState('06:00 AM');
                  const [newPhone, setNewPhone] = useState('');
                  const [newEmergency, setNewEmergency] = useState('');
                  const [newBlood, setNewBlood] = useState('O+');
                  const [newDesignation, setNewDesignation] = useState('General Under-Manager');
                  const [newNotes, setNewNotes] = useState('Medical fit.');
                  const [entryError, setEntryError] = useState('');
                  const [entrySuccess, setEntrySuccess] = useState('');

                  const handleAddWorker = (e) => {
                    e.preventDefault();
                    setEntryError('');
                    setEntrySuccess('');

                    const wIdClean = newWorkerId.trim().toUpperCase();
                    const hIdClean = newHelmetId.trim().toUpperCase();

                    if (!newName || !wIdClean || !hIdClean) {
                      setEntryError('Worker Name, Worker ID, and Helmet ID are mandatory.');
                      return;
                    }

                    // Duplicate ID check
                    if (workers.some(w => w.workerId.toUpperCase() === wIdClean)) {
                      setEntryError(`Duplicate Error: Worker ID "${wIdClean}" is already registered.`);
                      return;
                    }
                    if (workers.some(w => w.helmetId.toUpperCase() === hIdClean)) {
                      setEntryError(`Duplicate Error: Helmet ID "${hIdClean}" is already assigned.`);
                      return;
                    }

                    const newEntry = {
                      workerId: wIdClean,
                      helmetId: hIdClean,
                      name: newName.trim(),
                      block: newBlock,
                      zone: newZone,
                      shift: newShift,
                      entryTime: newEntryTime,
                      homePhone: newPhone || '+91 94311 00000',
                      emergencyContact: newEmergency || 'Not Specified',
                      bloodGroup: newBlood,
                      designation: newDesignation,
                      medicalNotes: newNotes,
                      isInsideMine: true,
                      history: [`Registered at ${new Date().toLocaleTimeString()}`],
                      telemetry: { online: true, battery: 100, mq2_methane_ppm: 25, mq7_co_ppm: 6, oxygen_pct: 20.9, temp_c: 24, humidity_pct: 58, motionState: 'ACTIVE', fallDetected: false, impactDetected: false, sosPressed: false, waterDetected: false, signal_rssi: -52, lastMotionTimestamp: Date.now(), rescueStatus: 'NONE' }
                    };

                    setWorkers([newEntry, ...workers]);
                    setEntrySuccess(`Worker ${newName} (${wIdClean}) registered successfully!`);
                    setTimeout(() => navigate('#workers'), 1200);
                  };

                  return (
                    <div className="max-w-3xl mx-auto space-y-6 animate-page-slide">
