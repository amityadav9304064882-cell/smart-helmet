                        </div>
                        <div className="flex space-x-2">
                          <button
                            onClick={() => {
                              setWorkers(workers.map(w => w.workerId === worker.workerId ? { ...w, telemetry: { ...w.telemetry, sosPressed: !w.telemetry.sosPressed } } : w));
