                                <div className="text-xs text-mine-400">{w.workerId} • Helmet: {w.helmetId}</div>
                              </div>
                            </div>
                            <span className="text-xs font-bold px-2 py-0.5 rounded" style={{ backgroundColor: `${s.color}20`, color: s.color }}>
