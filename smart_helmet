                        <h2 className="text-lg font-bold text-white">New Worker & Helmet Entry</h2>
                        <button onClick={() => navigate('#workers')} className="text-xs text-mine-400 hover:text-white">Cancel</button>
                      </div>

                      {entryError && <div className="p-3 bg-red-500/15 border border-red-500 rounded-xl text-xs text-red-300">{entryError}</div>}
                      {entrySuccess && <div className="p-3 bg-emerald-500/15 border border-emerald-500 rounded-xl text-xs text-emerald-300">{entrySuccess}</div>}

                      <form onSubmit={handleAddWorker} className="bg-mine-900 border border-mine-800 rounded-3xl p-6 space-y-4 text-xs">
                        <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
                          <div>
                            <label className="block text-mine-400 mb-1">Worker Name *</label>
                            <input type="text" value={newName} onChange={e => setNewName(e.target.value)} required className="w-full px-3 py-2 bg-mine-950 border border-mine-800 rounded-xl text-white font-mono" />
                          </div>
                          <div>
                            <label className="block text-mine-400 mb-1">Worker ID (Unique) *</label>
                            <input type="text" value={newWorkerId} onChange={e => setNewWorkerId(e.target.value)} placeholder="WRK-A-007" required className="w-full px-3 py-2 bg-mine-950 border border-mine-800 rounded-xl text-white uppercase font-mono" />
                          </div>
                          <div>
                            <label className="block text-mine-400 mb-1">Helmet ID (Unique) *</label>
                            <input type="text" value={newHelmetId} onChange={e => setNewHelmetId(e.target.value)} placeholder="HLM-A-007" required className="w-full px-3 py-2 bg-mine-950 border border-mine-800 rounded-xl text-white uppercase font-mono" />
                          </div>
                        </div>

                        <div className="grid grid-cols-1 sm:grid-cols-4 gap-3">
                          <div>
                            <label className="block text-mine-400 mb-1">Mine Block</label>
                            <select value={newBlock} onChange={e => setNewBlock(e.target.value)} className="w-full px-3 py-2 bg-mine-950 border border-mine-800 rounded-xl text-white">
                              <option value="A">Block A</option>
                              <option value="B">Block B</option>
                              <option value="C">Block C</option>
                              <option value="D">Block D</option>
                              <option value="E">Block E</option>
                            </select>
                          </div>
                          <div>
                            <label className="block text-mine-400 mb-1">Zone</label>
                            <input type="text" value={newZone} onChange={e => setNewZone(e.target.value)} className="w-full px-3 py-2 bg-mine-950 border border-mine-800 rounded-xl text-white" />
                          </div>
                          <div>
                            <label className="block text-mine-400 mb-1">Shift</label>
                            <input type="text" value={newShift} onChange={e => setNewShift(e.target.value)} className="w-full px-3 py-2 bg-mine-950 border border-mine-800 rounded-xl text-white" />
                          </div>
                          <div>
                            <label className="block text-mine-400 mb-1">Entry Time</label>
                            <input type="text" value={newEntryTime} onChange={e => setNewEntryTime(e.target.value)} className="w-full px-3 py-2 bg-mine-950 border border-mine-800 rounded-xl text-white" />
                          </div>
                        </div>

                        <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
                          <div>
                            <label className="block text-mine-400 mb-1">Home Phone *</label>
                            <input type="text" value={newPhone} onChange={e => setNewPhone(e.target.value)} required placeholder="+91 94311 02845" className="w-full px-3 py-2 bg-mine-950 border border-mine-800 rounded-xl text-white" />
                          </div>
                          <div>
                            <label className="block text-mine-400 mb-1">Emergency Contact *</label>
                            <input type="text" value={newEmergency} onChange={e => setNewEmergency(e.target.value)} required placeholder="+91 98765 43210 (Wife)" className="w-full px-3 py-2 bg-mine-950 border border-mine-800 rounded-xl text-white" />
                          </div>
                          <div>
                            <label className="block text-mine-400 mb-1">Blood Group</label>
                            <select value={newBlood} onChange={e => setNewBlood(e.target.value)} className="w-full px-3 py-2 bg-mine-950 border border-mine-800 rounded-xl text-white">
                              <option>O+</option><option>A+</option><option>B+</option><option>AB+</option><option>O-</option><option>A-</option><option>B-</option><option>AB-</option>
                            </select>
                          </div>
                        </div>

                        <div className="flex justify-end space-x-3 pt-3 border-t border-mine-800">
                          <button type="button" onClick={() => navigate('#workers')} className="px-4 py-2 rounded-xl bg-mine-950 text-mine-400 border border-mine-800">Cancel</button>
                          <button type="submit" className="px-5 py-2.5 rounded-xl bg-hazard text-mine-950 font-black uppercase">Save & Assign Helmet</button>
                        </div>
                      </form>
                    </div>
                  );
                })()
              )}

              {/* ROUTE 7: WORKER DETAILS DASHBOARD (#worker-details and #worker-details/:workerId) */}
              {(currentRoute === '#worker-details' || currentRoute.startsWith('#worker-details')) && (
                (() => {
